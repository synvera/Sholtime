<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvJudulPanduan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Takbiratul Ihram"
            android:textColor="#10B981"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPenjelasanPanduan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="Penjelasan gerakan..."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvArabPanduan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:text="اللَّهُ أَكْبَرُ"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLatinPanduan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Allahu Akbar"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvArtiPanduan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Artinya: Allah Maha Besar"
            android:textSize="13sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>