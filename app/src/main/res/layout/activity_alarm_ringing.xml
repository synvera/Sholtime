<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ringingRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ringing_liquid_root">

    <!-- Konten Utama yang Ikut Terangkat Saat Diusap ke Atas -->
    <LinearLayout
        android:id="@+id/mainRingingContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        app:layout_constraintBottom_toTopOf="@id/bottomSwipeZone"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSubtitleAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assalamu'alaikum, saatnya sholat"
            android:textColor="#A7F3D0"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvJamSekarangRinging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02"
            android:text="04:49"
            android:textColor="#FFFFFF"
            android:textSize="74sp" />

        <!-- Kapsul Kaca Lembut Nama Sholat -->
        <LinearLayout
            android:id="@+id/pillPrayerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_liquid_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Ikon Sholat"
                    android:src="@drawable/ic_nav_alarm"
                    app:tint="#6EE7B7" />

                <TextView
                    android:id="@+id/tvNamaSholatRinging"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Sholat Subuh"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvInfoSnooze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pengingat ke-1 dari 3 kali"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tombol Tunda (Tetap Berbentuk Button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnoozeAlarm"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:paddingHorizontal="30dp"
            android:text="Ingatkan 5 menit lagi"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            app:backgroundTint="#22FFFFFF"
            app:cornerRadius="25dp"
            app:strokeColor="#45FFFFFF"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- Area Bebas Usap ke Atas di Bagian Bawah Layar -->
    <LinearLayout
        android:id="@+id/bottomSwipeZone"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/swipeHintContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.9"
                android:contentDescription="Usap ke atas"
                android:src="@drawable/ic_arrow_up"
                app:tint="#6EE7B7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Usap ke atas untuk mematikan"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_pill" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>